<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".Generators", ""))</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder> <!-- See setup-dotnet GitHub Actions workflow documentation -->

    <PackageId>Diabase.StrongTypes</PackageId>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>R-Technics</Authors>
    <Description>Strong types for C#, generated by a source generator</Description>
    <PackageTags>strongtypes;sourcegenerator;roslyn;csharp</PackageTags>
    <RepositoryUrl>https://github.com/rtechnics/Diabase.StrongTypes</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!--
    The generator assembly is packed manually into analyzers/dotnet/cs rather than the default lib folder.
    See the packing ItemGroup below.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoPackageAnalysis>true</NoPackageAnalysis>

    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets=all keeps Roslyn out of the package's dependency list -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
    The generator is compiled against the runtime types. PrivateAssets=all means this reference is not published as a
    NuGet dependency; instead the Types assembly is redistributed inside this same package (see the ItemGroup below).
    -->
    <ProjectReference Include="..\Types\Diabase.StrongTypes.Types.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../TemplateDesign/Templates/*.cs">
      <LogicalName>Diabase.StrongTypes.Templates.%(Filename).cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
    One package:
      analyzers/dotnet/cs - the generator, plus the runtime assembly so the compiler can load the generator's dependency
      lib/netstandard2.0  - the runtime assembly, referenced by consumer code
    The referenced project's output is copied next to this assembly, so it exists in $(OutputPath) by the time pack runs.
    -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)Diabase.StrongTypes.Types.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)Diabase.StrongTypes.Types.dll" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
  </ItemGroup>

  <!--
  ProjectReference consumers (e.g. Tests) run the generator from the local build output, where Diabase.StrongTypes.Types.dll
  sits beside this assembly but is not automatically visible to the compiler's analyzer load context.
  -->
  <Target Name="GetDependencyTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(ReferenceCopyLocalPaths)"
                                           Condition="'%(Filename)%(Extension)' == 'Diabase.StrongTypes.Types.dll'"
                                           IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
