<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_").Replace(".Generators", ""))</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder> <!-- See setup-dotnet GitHub Actions workflow documentation -->
    <PackageId>Diabase.StrongTypes.Generators</PackageId>
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>R-Technics</Authors>
    <Description>Strong type source generator</Description>
    <PackageTags>sourcegenerator;roslyn;csharp</PackageTags>
    <RepositoryUrl>https://github.com/rtechnics/Diabase.StrongTypes</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking> <!-- Consumers do not need Microsoft.CodeAnalysis.*, and version conflicts occur with other frameworks such as ASP.NET -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../TemplateDesign/Templates/*.cs">
      <LogicalName>Diabase.StrongTypes.Templates.%(Filename).cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
  In its current state, rather than building the `Types` project separately, it bundles it in the same build as `Generators` by copying the source files. Ideally, we should use a more conventional approach, but it requires a lot of modifications. See the GitHub issue #12.
  -->
  <Target Name="StageGeneratorInputs" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_TypesSrc Include="$(MSBuildProjectDirectory)/../Types/**/*.cs"
                 Exclude="$(MSBuildProjectDirectory)/../Types/obj/**;$(MSBuildProjectDirectory)/../Types/bin/**" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)Generated/Types" />
    <Copy SourceFiles="@(_TypesSrc)"
          DestinationFiles="@(_TypesSrc->'$(IntermediateOutputPath)Generated/Types/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Generated/Types/**/*.cs" />
    </ItemGroup>
  </Target>

  <!--
  Nuget packages use `lib` for runtime dependencies and `analyzers` for analyzers. The DLL needs to go in both folders so that consumer projects correctly detect it as an analyzer and the Types project contents resolve at runtime.
  -->
  <Target Name="_AddAnalyzerToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
